---
import '../styles/global.css';
import { crewPalette } from '../config/brand.ts';
import Seo from '../components/Seo.astro';
import { resolveLocale } from '../i18n/index.ts';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang={resolveLocale(Astro.currentLocale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The headline is the first thing painted, so fetch its font early. -->
    <link
      rel="preload"
      href="/fonts/Manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style
      is:inline
      set:html={`:root {${Object.entries(crewPalette)
        .map(([name, hex]) => `--${name}: ${hex};`)
        .join('')}}`}
    ></style>
    <Seo title={title} description={description} noindex={noindex} />
    <!-- Motion styles only apply once scripts can run them. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
