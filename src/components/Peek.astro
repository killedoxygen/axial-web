---
import Axolotl from './Axolotl.astro';

import type { CrewColor } from '../config/brand.ts';

interface Props {
  color: CrewColor;
  /** How much of the axolotl shows above the edge it hides behind. */
  crop?: 'eyes' | 'smile';
}

const { color, crop = 'eyes' } = Astro.props;
---

<span class={`peek peek--${color}`} aria-hidden="true"
  ><Axolotl crop={crop} /></span
>
