---
import Peek from '../Peek.astro';

interface Props {
  color: 'green' | 'peri' | 'cyan' | 'pink' | 'yellow';
  title: string;
  body: string;
}

const { color, title, body } = Astro.props;
---

<article class={`sheet sheet--${color} reveal`}>
  <div class="sheet-in">
    <div class="sheet-text">
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <!-- Illustrations restate the text beside them, so they stay out of the
         accessibility tree. -->
    <div class="sheet-art" aria-hidden="true">
      <Peek color={color} />
      <slot />
    </div>
  </div>
</article>
